# Copy to .env and fill in. Never commit the real .env.

# https://console.groq.com/keys  (LLM explanations)
GROQ_API_KEY=your_groq_api_key_here
# Optional: override the Groq model (check Groq's current model list)
# GROQ_MODEL=openai/gpt-oss-20b

# https://www.weatherapi.com/  (weather + 7-day forecast)
WEATHER_API_KEY=your_weatherapi_key_here
